{
  "name": "@emmett-community/emmett-google-services-bootstrap",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "description": "Service bootstrap for event-driven apps using Google Cloud (Firebase, PubSub)",
  "scripts": {
    "build": "tsup",
    "build:ts": "tsc",
    "build:ts:watch": "tsc -b --watch",
    "test": "run-s test:unit test:int test:e2e",
    "test:unit": "glob -c \"node --import tsx --import tsx/cjs --test\" \"test/unit/**/*.unit.spec.ts\"",
    "test:int": "glob -c \"node --import tsx --import tsx/cjs --test\" \"test/integration/**/*.int.spec.ts\"",
    "test:e2e": "glob -c \"node --import tsx --import tsx/cjs --test\" \"test/e2e/**/*.e2e.spec.ts\"",
    "test:watch": "node --import tsx --import tsx/cjs --test --watch",
    "test:unit:watch": "glob -c \"node --import tsx --import tsx/cjs --test --watch\" \"test/unit/**/*.unit.spec.ts\"",
    "test:int:watch": "glob -c \"node --import tsx --import tsx/cjs --test --watch\" \"test/integration/**/*.int.spec.ts\"",
    "test:e2e:watch": "glob -c \"node --import tsx --import tsx/cjs --test --watch\" \"test/e2e/**/*.e2e.spec.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emmett-community/emmett-google-services-bootstrap.git"
  },
  "keywords": [
    "emmett",
    "event-driven",
    "bootstrap",
    "google-cloud",
    "firebase",
    "firestore",
    "pubsub",
    "realtime-db"
  ],
  "author": "Andre X Costa",
  "bugs": {
    "url": "https://github.com/emmett-community/emmett-google-services-bootstrap/issues"
  },
  "homepage": "https://github.com/emmett-community/emmett-google-services-bootstrap#readme",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@event-driven-io/emmett": "^0.39.0",
    "@emmett-community/emmett-google-firestore": "^0.4.0",
    "@emmett-community/emmett-google-pubsub": "^0.3.0",
    "@emmett-community/emmett-google-realtime-db": "^0.5.0",
    "@emmett-community/emmett-observability": "^0.3.0",
    "@emmett-community/emmett-expressjs-with-openapi": "^0.7.0",
    "@google-cloud/pubsub": "^4.9.0",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-openapi-validator": "^5.6.0",
    "firebase-admin": "^13.6.0",
    "@my-f-startup/firebase-auth-express": "^0.1.0",
    "http-problem-details": "^0.1.7",
    "pino-http": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "glob": "^11.0.0",
    "npm-run-all2": "^7.0.0",
    "testcontainers": "^10.28.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
